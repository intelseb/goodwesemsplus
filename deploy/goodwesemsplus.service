[Unit]
Description=GoodWe SEMS+ to PVOutput poller
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/goodwesemsplus
Environment=NODE_ENV=production
# If `which npm` is not /usr/bin/npm, change ExecStart to that path.
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
